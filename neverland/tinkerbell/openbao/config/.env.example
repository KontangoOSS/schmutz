# APPNAME Configuration
# Copy: cp .env.example .env

# --- Application ---
APP_NAME=APPNAME
APP_PORT=8080
LOG_LEVEL=info

# --- Database (uncomment if needed) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=APPNAME
# DB_USER=APPNAME
# DB_PASSWORD=changeme

# --- Authentication (uncomment if needed) ---
# JWT_SECRET=minimum-32-characters-change-this

# --- Storage (uncomment if needed) ---
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=APPNAME
