# Copy to .env and fill in values before running docker compose up

# The hostname this stack will be reachable at (used in Ziti PKI)
ZITI_HOST=localhost

# Ziti admin credentials (set on first boot, used by enroll + controller)
ZITI_ADMIN_USER=admin
# Ziti requires: min 8 chars, 1 uppercase, 1 number, 1 special char
ZITI_ADMIN_PASS=Admin1234!

# Bao root token — obtained after running init:
#   docker compose up -d bao
#   docker compose exec bao sh /etc/bao/init.sh
#   → copy the root token printed here
BAO_ROOT_TOKEN=

# Bao unseal key — from the same init output.
# Set this so Bao auto-unseals on container restart.
# (In production use Transit auto-unseal or HSM instead of env var)
BAO_UNSEAL_KEY=

# Forgejo API token (create after first boot via Forgejo admin UI)
FORGEJO_TOKEN=

# Operator token for hub enrollment API (X-Kontango-Token header)
HUB_ADMIN_TOKEN=dev-admin-token
