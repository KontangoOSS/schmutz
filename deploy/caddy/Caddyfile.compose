{
  admin off
  # In compose, ACME isn't usable without a real domain.
  # Use auto_https off for local testing; swap for acme_dns in production.
  auto_https off

  layer4 {
    :443 {
      # Ziti control plane — ALPN-based routing
      @ziti-ctrl tls alpn ziti-ctrl
      route @ziti-ctrl {
        proxy ziti:6262
      }

      @ziti-link tls alpn ziti-link
      route @ziti-link {
        proxy ziti:10080
      }

      @ziti-edge tls alpn ziti-edge
      route @ziti-edge {
        proxy ziti:3023
      }

      # Enrollment hub — SNI based
      @enroll tls sni enroll.*
      route @enroll {
        proxy enroll:8765
      }

      # Controller management plane — SNI based
      @ctrl tls sni ctrl.*
      route @ctrl {
        proxy controller:3080
      }

      # All other TLS → Ziti edge management API
      @tls-any tls
      route @tls-any {
        proxy ziti:1280
      }
    }
  }
}
