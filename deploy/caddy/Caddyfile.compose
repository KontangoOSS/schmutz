{
  admin off
  local_certs

  layer4 {
    :443 {
      # Ziti SDK ALPN connections
      @ziti-ctrl tls alpn ziti-ctrl
      route @ziti-ctrl {
        proxy ziti:6262
      }

      @ziti-link tls alpn ziti-link
      route @ziti-link {
        proxy ziti:6262
      }

      @ziti-edge tls alpn ziti-edge
      route @ziti-edge {
        proxy ziti:6262
      }

      # SNI: enroll endpoint → Caddy HTTPS vhost on :9443
      @enroll tls sni enroll.schmutz.local
      route @enroll {
        proxy localhost:9443
      }

      # SNI: controller management plane → Caddy HTTPS vhost on :9444
      @ctrl tls sni ctrl.schmutz.local
      route @ctrl {
        proxy localhost:9444
      }

      # Default: all other TLS → Ziti
      @tls-any tls
      route @tls-any {
        proxy ziti:6262
      }
    }
  }
}

# ── Enroll vhost (:9443) ─────────────────────────────────────────────────
enroll.schmutz.local:9443 {
  tls internal

  handle /agent.sh {
    respond "#!/bin/sh\necho schmutz-agent-bootstrap" 200
  }

  handle /api/* {
    reverse_proxy enroll:8765
  }

  handle /healthz {
    reverse_proxy enroll:8765
  }

  respond "schmutz-enroll" 200
}

# ── Controller vhost (:9444) ─────────────────────────────────────────────
ctrl.schmutz.local:9444 {
  tls internal

  handle /api/* {
    reverse_proxy controller:3080
  }

  respond "schmutz-controller" 200
}
