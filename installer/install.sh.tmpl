#!/bin/bash
# Schmutz installer — generated by TangoKore for {{.DeviceID}}
set -euo pipefail

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64|amd64) ARCH="amd64" ;;
  aarch64|arm64) ARCH="arm64" ;;
  *) echo "unsupported arch: $ARCH" >&2; exit 1 ;;
esac

echo "schmutz: installing for {{.DeviceID}} (linux/$ARCH)"

curl -fsSL "{{.ReleaseBase}}/schmutz-linux-$ARCH" -o /usr/local/bin/schmutz
chmod +x /usr/local/bin/schmutz

id schmutz &>/dev/null || useradd -r -s /sbin/nologin -d /etc/schmutz schmutz

mkdir -p /etc/schmutz /var/lib/schmutz
cat > /etc/schmutz/manifest.yaml << 'MANIFEST'
{{.ManifestYAML}}
MANIFEST
chown -R schmutz:schmutz /etc/schmutz /var/lib/schmutz
chmod 600 /etc/schmutz/manifest.yaml

cat > /etc/systemd/system/schmutz.service << 'UNIT'
{{.SystemdUnit}}
UNIT

systemctl daemon-reload
systemctl enable --now schmutz
echo "schmutz: installed — systemctl status schmutz"
